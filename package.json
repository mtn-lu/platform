{
  "name": "@mtn-lu/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types --env-interface CloudflareEnv --strict-vars=false",
    "setup": "node scripts/setup.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "access": "node scripts/access.ts",
    "preflight": "node scripts/preflight.ts"
  },
  "dependencies": {
    "better-auth": "1.7.3",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wouter": "3.11.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/vitest-plugin": "1.1.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
