{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-production-worker-name",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE-DATABASE-NAME",
      "database_id": "REPLACE-DATABASE-ID",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "CANONICAL_ORIGIN": "https://mtn.lu",
    "RETURN_ORIGINS": "https://mtn.lu",
    "EMAIL_MODE": "resend",
    "EMAIL_FROM": "login@auth.mtn.lu",
    "LINK_ADDRESS_LIMIT": "3",
    "LINK_IP_LIMIT": "20",
    "DAILY_EMAIL_LIMIT": "50",
    "CONFIRM_IP_LIMIT": "30",
  },
  "observability": {
    "enabled": false,
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "account_id": "a576f5422f8d35ba609addec2bf36ffc",
  "routes": [
    {
      "pattern": "mtn.lu",
      "custom_domain": true,
    },
  ],
}
